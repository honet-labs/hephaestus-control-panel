# ==========================================
# Frontend Build Stage
# ==========================================
ARG REGISTRY_MIRROR=""
FROM ${REGISTRY_MIRROR}node:24-alpine AS builder

WORKDIR /app

COPY web/package*.json ./
RUN npm ci

COPY web/ ./
RUN npm run build

# ==========================================
# Frontend Production Nginx Runtime Stage
# ==========================================
FROM ${REGISTRY_MIRROR}nginx:1.30.7-alpine

RUN apk upgrade --no-cache && apk add --no-cache openssl tzdata

ENV TZ=Asia/Jakarta

COPY --from=builder /app/dist /usr/share/nginx/html
COPY web/nginx.conf /etc/nginx/nginx.conf
COPY web/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 80 443

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
