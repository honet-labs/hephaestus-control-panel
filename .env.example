# Server Configuration
PORT=5000
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000

# Docker Registry Mirror (Default uses Amazon ECR Public mirror to avoid Docker Hub TLS proxy blocks)
REGISTRY_MIRROR=public.ecr.aws/docker/library/

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hephaestus
DB_SSL=false

# Database Connection Pool Tuning (Resource Optimization)
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_IDLE_TIME=300
DB_MAX_CONN_LIFETIME=3600

# PostgreSQL Server Resource Tuning (For docker-compose database service)
POSTGRES_SHARED_BUFFERS=64MB
POSTGRES_WORK_MEM=4MB
POSTGRES_MAINTENANCE_WORK_MEM=16MB
POSTGRES_MAX_CONNECTIONS=40
POSTGRES_WAL_BUFFERS=4MB

# Go Runtime Garbage Collector & Memory Tuning
GOMEMLIMIT=256MiB
GOGC=80

# Security & Encryption (64-char Hexadecimal Key for AES-256-GCM)
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Directories
LOGS_DIR=./logs
DATA_DIR=./data
BACKUP_DIR=./backups
