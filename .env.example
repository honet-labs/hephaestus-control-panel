# Server Configuration
PORT=5000
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000

# Docker Registry Mirror (Default uses Amazon ECR Public mirror to avoid Docker Hub TLS proxy blocks)
REGISTRY_MIRROR=public.ecr.aws/docker/library/

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hephaestus
DB_SSL=false

# Security & Encryption (64-char Hexadecimal Key for AES-256-GCM)
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Directories
LOGS_DIR=./logs
DATA_DIR=./data
