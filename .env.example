# Server Configuration
PORT=5000
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000
TZ=Asia/Jakarta

# Docker Registry Mirror (Default uses Amazon ECR Public mirror to avoid Docker Hub TLS proxy blocks)
REGISTRY_MIRROR=public.ecr.aws/docker/library/

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=hephaestus
DB_PASSWORD=replace_with_strong_database_password
DB_NAME=hephaestus
DB_SSL=false

# Database Connection Pool Tuning (Resource Optimization)
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_IDLE_TIME=300
DB_MAX_CONN_LIFETIME=3600

# PostgreSQL Server Resource Tuning (For docker-compose database service)
POSTGRES_SHARED_BUFFERS=64MB
POSTGRES_WORK_MEM=4MB
POSTGRES_MAINTENANCE_WORK_MEM=16MB
POSTGRES_MAX_CONNECTIONS=40
POSTGRES_WAL_BUFFERS=4MB

# Go Runtime Garbage Collector & Memory Tuning
GOMEMLIMIT=256MiB
GOGC=80

# Security & Encryption (64-char Hexadecimal Key for AES-256-GCM)
# Generate a secure 64-char key using: openssl rand -hex 32
APP_ENCRYPTION_KEY=replace_with_64_char_hex_key_from_openssl_rand_hex_32

# SSH host identity: default is persisted trust-on-first-use (TOFU).
# Persist DATA_DIR across container replacements; verify first-use fingerprints out of band.
# For pre-provisioned trusted keys, set SSH_HOST_KEY_POLICY=strict.
SSH_HOST_KEY_POLICY=tofu
# SSH_KNOWN_HOSTS=/app/data/known_hosts
SSH_ALLOW_LEGACY_ALGORITHMS=false

# Reporting/status-page HTTPS verifies certificates by default.
# Prefer installing your private CA (SSL_CERT_FILE/SSL_CERT_DIR), not disabling verification.
ALLOW_INSECURE_INTEGRATION_TLS=false

# Native/custom deployments: optional absolute path to a pg_dump client whose
# major version matches the source PostgreSQL server (required for same-major restores).
# PG_DUMP_BIN=/usr/lib/postgresql/16/bin/pg_dump

# Guacamole Remote Desktop Proxy Daemon (guacd)
GUACD_HOST=guacd
GUACD_PORT=4822

# Directories
LOGS_DIR=./logs
DATA_DIR=./data
BACKUP_DIR=./backups
