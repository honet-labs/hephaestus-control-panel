# ==========================================
# Backend Build Stage
# ==========================================
ARG REGISTRY_MIRROR=""
FROM ${REGISTRY_MIRROR}golang:1.22-alpine AS builder

WORKDIR /app

ENV GOPROXY=https://proxy.golang.org,https://goproxy.io,direct \
    CGO_ENABLED=0 \
    GOOS=linux

# Copy all source files
COPY . ./

# Resolve dependencies and compile static binary
RUN go mod tidy && \
    go build -ldflags="-w -s" -o /app/hephaestus ./cmd/server && \
    go build -ldflags="-w -s" -o /app/hcp-cli ./cmd/cli

# ==========================================
# Backend Production Runtime Stage
# ==========================================
FROM ${REGISTRY_MIRROR}alpine:3.20

RUN (sed -i 's/dl-cdn.alpinelinux.org/mirrors.edge.kernel.org/g' /etc/apk/repositories 2>/dev/null || true) && \
    (apk add --no-cache ca-certificates tzdata postgresql16-client mysql-client openssh-client iputils curl 2>/dev/null || \
     apk add --no-cache ca-certificates tzdata curl 2>/dev/null || true)

WORKDIR /app

COPY --from=builder /app/hephaestus /app/hephaestus
COPY --from=builder /app/hcp-cli /app/hcp-cli
RUN ln -sf /app/hcp-cli /usr/local/bin/hcp-cli && ln -sf /app/hephaestus /usr/local/bin/hephaestus
COPY internal/database/migrations /app/internal/database/migrations

# Create storage directories
RUN mkdir -p /app/data/mibs /app/logs /app/backups

ENV PORT=5000 \
    APP_ENV=production \
    LOGS_DIR=/app/logs \
    DATA_DIR=/app/data

EXPOSE 5000

ENTRYPOINT ["/app/hephaestus"]
