# ==========================================
# Backend Build Stage
# ==========================================
ARG REGISTRY_MIRROR=""
FROM ${REGISTRY_MIRROR}golang:1.23-alpine AS builder

WORKDIR /app

ENV GOPROXY=https://proxy.golang.org,https://goproxy.io,direct \
    CGO_ENABLED=0 \
    GOOS=linux

# Copy all source files
COPY . ./

# Resolve dependencies and compile static binary
RUN go mod tidy && \
    go build -ldflags="-w -s" -o /app/hephaestus ./cmd/server && \
    go build -ldflags="-w -s" -o /app/hcp-cli ./cmd/cli

# ==========================================
# Backend Production Runtime Stage
# ==========================================
FROM ${REGISTRY_MIRROR}alpine:3.20

RUN (sed -i 's/dl-cdn.alpinelinux.org/mirrors.edge.kernel.org/g' /etc/apk/repositories 2>/dev/null || true) && \
    (apk add --no-cache ca-certificates tzdata postgresql-client postgresql16-client mariadb-client openssh-client iputils curl net-snmp-tools bind-tools tar gzip socat bash || \
     ((sed -i 's/mirrors.edge.kernel.org/dl-cdn.alpinelinux.org/g' /etc/apk/repositories 2>/dev/null || true) && \
      apk add --no-cache ca-certificates tzdata postgresql-client postgresql16-client mariadb-client openssh-client iputils curl net-snmp-tools bind-tools tar gzip socat bash))

WORKDIR /app

COPY --from=builder /app/hephaestus /app/hephaestus
COPY --from=builder /app/hcp-cli /app/hcp-cli
RUN ln -sf /app/hcp-cli /usr/local/bin/hcp-cli && ln -sf /app/hephaestus /usr/local/bin/hephaestus
COPY internal/database/migrations /app/internal/database/migrations

# Copy bundled MIBs into container
COPY data/mibs /app/bundled_mibs
COPY data/mibs /app/data/mibs

# Create storage directories and link MIBs for net-snmp-tools
RUN mkdir -p /app/data/mibs /app/logs /app/backups /opt/backups /usr/share/snmp/mibs && \
    ln -sf /app/data/mibs /usr/share/snmp/mibs/bundled 2>/dev/null || true

ENV PORT=5000 \
    APP_ENV=production \
    LOGS_DIR=/app/logs \
    DATA_DIR=/app/data \
    TZ=Asia/Jakarta \
    MIBDIRS=+/app/data/mibs:/app/bundled_mibs \
    MIBS=ALL

EXPOSE 5000

ENTRYPOINT ["/app/hephaestus"]
